{
  "name": "glossix-studio",
  "version": "1.5.12",
  "description": "Beginner language learning studio",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --config electron-builder.cjs --win --publish never",
    "release:win": "node scripts/build-signed.cjs --publish",
    "configure:updates": "node scripts/configure-updates.cjs",
    "dist:win:signed": "node scripts/build-signed.cjs",
    "build:translations": "node scripts/build-translations.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "productName": "Glossix",
  "author": "Glossix",
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
